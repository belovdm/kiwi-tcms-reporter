{
  "name": "@kiwi-tcms-ai/kiwi-tcms-reporter",
  "version": "0.1.0",
  "description": "Playwright / Jest / Mocha reporters and a JUnit/JSON pipe that sync automated test results into Kiwi TCMS",
  "license": "MIT",
  "author": "Belov <belov.u30gt@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belovdm/kiwi-tcms-reporter.git"
  },
  "bugs": {
    "url": "https://github.com/belovdm/kiwi-tcms-reporter/issues"
  },
  "homepage": "https://github.com/belovdm/kiwi-tcms-reporter#readme",
  "keywords": [
    "kiwi-tcms",
    "tcms",
    "reporter",
    "playwright",
    "jest",
    "mocha",
    "junit",
    "test-management"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kiwi-tcms-pipe": "dist/pipe.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/reporter-playwright.d.ts",
      "default": "./dist/reporter-playwright.js"
    },
    "./jest": {
      "types": "./dist/reporter-jest.d.ts",
      "default": "./dist/reporter-jest.js"
    },
    "./mocha": {
      "types": "./dist/reporter-mocha.d.ts",
      "default": "./dist/reporter-mocha.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@kiwi-tcms-ai/kiwi-tcms-client": "^0.1.0"
  }
}
